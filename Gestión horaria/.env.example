# =============================================================================
# HABILIS GESTIÓN HORARIA - CONFIGURACIÓN DE FIREBASE (NUEVA BASE DE DATOS)
# =============================================================================
# Copia este archivo a '.env' y completa con las credenciales del nuevo proyecto
# de Firebase creado exclusivamente para el Registro Horario.
#
# Mientras no se configure un proyecto de Firebase, la aplicación funcionará
# automáticamente en 'Modo Local / Prototipo' con persistencia en localStorage
# y operarios de prueba precargados (Carlos Gómez, María López, etc.).
# =============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
